# RafSkoru backend — örnek ortam değişkenleri.
# Kopyala: cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# .env asla repoya girmez (.gitignore).

PORT=3001
NODE_ENV=development

# ── Intake (gönüllü ürün toplama) ───────────────────────────────────────────
# Panel (yönetici) uç noktaları için tek anahtar. Boşsa panel uç noktaları
# kapalı kalır (503 döner) — gönüllü uç noktaları etkilenmez.
INTAKE_ADMIN_KEY=

# Gönüllü kod+anahtar çiftleri — GÖNÜLLÜ BAŞINA ayrı anahtar (ortak anahtar
# DEĞİL), tek kişinin erişimi kapatılabilsin diye. İki seçenekten biri:
#   1) Bu değişkeni satır içi JSON olarak doldur (konteyner dağıtımları için):
#      INTAKE_VOLUNTEERS_JSON={"MRS-01":"degistir-bu-anahtari"}
#   2) Bu değişkeni BOŞ bırak, apps/backend/data/intake/volunteers.json
#      dosyasını elle oluştur (aynı format) — dosya her istekte yeniden
#      okunur, bir satırı silip kaydetmek o kişinin erişimini SÜREÇ YENİDEN
#      BAŞLATILMADAN hemen kapatır. Bu dosya repoya asla girmez.
INTAKE_VOLUNTEERS_JSON=

# ── Manuel beta fiyatları ────────────────────────────────────────────────
MANUAL_PRICES_PATH=./data/manual-prices.json

# ── Yönetici uç noktaları (mevcut fiyat API'si) ──────────────────────────
ADMIN_API_KEY=

# ── Mağaza mesafesi (şu an kullanılmıyor — seedStores boş, bkz. ADR-006) ──
STORE_LOCATOR_KIND=static
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DISABLED=true

# ── Geliştirme/hata ayıklama bayrakları ───────────────────────────────────
DEBUG_PRICE_RESOLVE=
ENABLE_BETA_FEEDBACK_LOGS=
ENABLE_BETA_QUERY_LOGS=

# ── Alternatif eşleştirme (kademeli geçiş bayrakları) ────────────────────
USE_CANONICAL_ALTERNATIVE_MATCHING=
SHADOW_CANONICAL_ALTERNATIVE_MATCHING=

# ── Yalnız geliştirme/test — production'da ASLA açılmaz ──────────────────
USE_ONLINE_TEST_PRICE_SEED=
