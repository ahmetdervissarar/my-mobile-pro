# RafSkoru backend — örnek ortam değişkenleri.
# Kopyala: cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# .env asla repoya girmez (.gitignore).

PORT=3001
NODE_ENV=development

# ── Sentetik (uydurma) skor/fiyat — YALNIZ GELİŞTİRME İÇİN ───────────────────
# inferBetaHealthScore/inferBetaContentScore ve BetaReferencePriceProvider
# GERÇEK veri değil: ürün ADINDAN anahtar kelime eşleşmesiyle skor/fiyat
# üretir (ör. "kola" → D notu, "makarna" → B notu, kategori bazlı demo
# fiyat). NODE_ENV=production iken bu VARSAYILAN KAPALIDIR; açmak için
# açıkça ENABLE_SYNTHETIC_SCORES=1 gerekir. NODE_ENV=development'ta (veya
# tanımsızken) her zaman açıktır — yerel geliştirmede ekranların boş
# görünmemesi için.
ENABLE_SYNTHETIC_SCORES=

# ── Manuel beta fiyatları ────────────────────────────────────────────────
MANUAL_PRICES_PATH=./data/manual-prices.json

# ── Yönetici uç noktaları ──────────────────────────────────────────────────
ADMIN_API_KEY=

# ── Mağaza mesafesi (şu an kullanılmıyor — seedStores boş, bkz. ADR-006) ──
STORE_LOCATOR_KIND=static
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DISABLED=true

# ── Geliştirme/hata ayıklama bayrakları ───────────────────────────────────
DEBUG_PRICE_RESOLVE=
ENABLE_BETA_FEEDBACK_LOGS=
ENABLE_BETA_QUERY_LOGS=

# ── Alternatif eşleştirme (kademeli geçiş bayrakları) ────────────────────
USE_CANONICAL_ALTERNATIVE_MATCHING=
SHADOW_CANONICAL_ALTERNATIVE_MATCHING=

# ── Yalnız geliştirme/test — production'da ASLA açılmaz ──────────────────
USE_ONLINE_TEST_PRICE_SEED=

# ── OCR (AŞAMA 1, feat/ocr-pipeline) ─────────────────────────────────────
# Varsayılan motor tesseract.js (yerel, sistem paketi gerektirmez, ağ
# çağrısı yapmaz — bkz. src/ocr/tesseractEngine.ts). Google Vision motoru
# HENÜZ EKLENMEDİ (@google-cloud/vision paketi yok); bu anahtar şimdiden
# okunuyor ki ad sabitlensin — anahtar girilse de motor DEĞİŞMEZ (log'a
# UYARI yazılır, değeri asla yazılmaz).
OCR_GOOGLE_VISION_API_KEY=
